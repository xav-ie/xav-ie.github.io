---
import { Font } from 'astro:assets';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'xav.ie',
  description = 'Personal site of Xavier Ruiz — a full-stack developer in Boston.',
} = Astro.props as Props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Xavier Ruiz',
  url: 'https://xav.ie',
  email: 'hello@xav.ie',
  jobTitle: 'Software Developer',
  homeLocation: { '@type': 'Place', name: 'Boston, Massachusetts' },
  knowsAbout: [
    'TypeScript',
    'Rust',
    'Nix',
    'NixOS',
    'Neovim',
    'Lua',
    'Nushell',
    'PipeWire',
    'D-Bus',
    'Model Context Protocol',
    'E-commerce',
    'Web performance',
    'Accessibility',
  ],
  sameAs: [
    'https://github.com/xav-ie',
    'https://www.linkedin.com/in/xav-ie/',
  ],
  image: 'https://xav.ie/og.png',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12081a" />
    <meta name="description" content={description} />
    <meta name="author" content="Xavier Ruiz" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href="https://xav.ie/" />
    <link rel="alternate" type="application/rss+xml" title="xav.ie" href="/rss.xml" />

    {/* Apply any stored theme override before first paint to avoid a
        light/dark flash on subsequent visits. Must be is:inline so
        Astro doesn't defer it; runs synchronously in <head>. */}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
        }
      } catch {
        /* localStorage unavailable — fall back to color-scheme. */
      }
    </script>

    <slot name="head" />

    <Font cssVariable="--font-ibm-plex-sans" preload />
    <Font cssVariable="--font-sorts-mill-goudy" preload />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="xav.ie" />
    <meta property="og:title" content="Xavier Ruiz" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://xav.ie/" />
    <meta property="og:image" content="https://xav.ie/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Xavier Ruiz" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://xav.ie/og.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
