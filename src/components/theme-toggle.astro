---
// Three-state theme selector: light | auto (system) | dark
// All three slots are always visible; clicking a slot selects it directly.
// The FOUC-prevention script in Base.astro applies the stored choice before
// first paint. data-no-transition (set there, removed here after first frame)
// prevents the @property initial-value flash on every page load.
---

<div
  id="theme-toggle"
  role="group"
  aria-label="Color theme"
  class="theme-toggle"
>
  <button
    type="button"
    class="theme-btn"
    data-theme="light"
    aria-label="Light mode"
    aria-pressed="false"
  >
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="12" y1="2" x2="12" y2="5"></line>
        <line x1="12" y1="19" x2="12" y2="22"></line>
        <line x1="2" y1="12" x2="5" y2="12"></line>
        <line x1="19" y1="12" x2="22" y2="12"></line>
        <line x1="4.5" y1="4.5" x2="6.6" y2="6.6"></line>
        <line x1="17.4" y1="17.4" x2="19.5" y2="19.5"></line>
        <line x1="4.5" y1="19.5" x2="6.6" y2="17.4"></line>
        <line x1="17.4" y1="6.6" x2="19.5" y2="4.5"></line>
      </g>
    </svg>
  </button>
  <button
    type="button"
    class="theme-btn"
    data-theme="auto"
    aria-label="System theme"
    aria-pressed="false"
  >
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <rect
        x="2"
        y="3"
        width="20"
        height="14"
        rx="2"
        stroke="currentColor"
        stroke-width="2"
        fill="none"></rect>
      <line
        x1="8"
        y1="21"
        x2="16"
        y2="21"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
      <line
        x1="12"
        y1="17"
        x2="12"
        y2="21"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></line>
    </svg>
  </button>
  <button
    type="button"
    class="theme-btn"
    data-theme="dark"
    aria-label="Dark mode"
    aria-pressed="false"
  >
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M21 13.5A9 9 0 1 1 10.5 3a7 7 0 0 0 10.5 10.5Z"></path>
    </svg>
  </button>
</div>

{
  /* Runs synchronously as the parser reaches this point — sets aria-pressed
     on the correct slot before first paint, matching the FOUC-applied theme. */
}
<script is:inline>
  (function () {
    let stored;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      /* empty */
    }
    const mode = stored === 'light' || stored === 'dark' ? stored : 'auto';
    const container = document.querySelector('#theme-toggle');
    if (!container) return;
    for (const button of container.querySelectorAll('[data-theme]')) {
      button.setAttribute(
        'aria-pressed',
        button.dataset.theme === mode ? 'true' : 'false',
      );
    }
  })();
</script>

<script>
  type ThemeMode = 'auto' | 'light' | 'dark';

  function currentMode(): ThemeMode {
    const t = document.documentElement.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return 'auto';
  }

  function applyMode(mode: ThemeMode) {
    if (mode === 'auto') {
      delete document.documentElement.dataset.theme;
      try {
        localStorage.removeItem('theme');
      } catch {
        /* ignore */
      }
    } else {
      document.documentElement.dataset.theme = mode;
      try {
        localStorage.setItem('theme', mode);
      } catch {
        /* ignore */
      }
    }
  }

  function syncButtons(container: Element) {
    const mode = currentMode();
    for (const button of container.querySelectorAll<HTMLButtonElement>(
      '[data-theme]',
    )) {
      button.setAttribute(
        'aria-pressed',
        button.dataset.theme === mode ? 'true' : 'false',
      );
    }
  }

  // AbortController so click listeners can be torn down before new ones are
  // added. Necessary because transition:persist keeps the nav (and toggle)
  // alive across navigations — without cleanup astro:page-load would stack
  // a new listener on the same element each time.
  let clickController = new AbortController();

  // Before the View Transition swap: carry data-theme and data-no-transition
  // into the incoming document, and abort stale click listeners.
  document.addEventListener(
    'astro:before-swap',
    (event_: Event & { newDocument: Document }) => {
      const theme = document.documentElement.dataset.theme;
      if (theme) {
        event_.newDocument.documentElement.dataset.theme = theme;
      }
      event_.newDocument.documentElement.dataset.noTransition = '';
      clickController.abort();
      clickController = new AbortController();
    },
  );

  // astro:page-load fires on both initial load and after every View
  // Transition — re-attach to the (possibly same, persisted) container.
  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(() => {
      delete document.documentElement.dataset.noTransition;
    });

    const container = document.querySelector<HTMLElement>('#theme-toggle');
    if (!container) return;

    syncButtons(container);

    for (const button of container.querySelectorAll<HTMLButtonElement>(
      '[data-theme]',
    )) {
      button.addEventListener(
        'click',
        () => {
          applyMode(button.dataset.theme as ThemeMode);
          syncButtons(container);
        },
        { signal: clickController.signal },
      );
    }
  });
</script>

<style>
  /* Pill container — inset trough so the active slot reads as raised above it */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
    background-color: var(--surface-bottom);
    box-shadow:
      inset 3px 3px 8px -1px var(--shadow),
      inset -1px -1px 3px -1px var(--highlight);
    transition: none;
  }

  /* Individual slot */
  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25em;
    height: 2.25em;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    opacity: 0.38;
    /* Only transition opacity — box-shadow and background reference @property
       vars that already animate via :root, adding a parallel transition here
       causes re-fire jitter during theme switches. */
    transition: opacity 0.15s ease-in-out;
  }

  .theme-btn:hover:not([aria-pressed='true']) {
    opacity: 0.65;
  }

  /* Active slot: raised pill above the trough */
  .theme-btn[aria-pressed='true'] {
    opacity: 1;
    background-color: var(--surface-top);
    box-shadow:
      3px 3px 8px -2px var(--shadow),
      -1px -1px 3px -1px var(--highlight),
      inset 0.5px 0.5px 1px rgba(255, 255, 255, 0.12);
  }

  .icon {
    display: block;
    width: 1.25em;
    height: 1.25em;
  }

  /* Dark mode: active slot uses the shared bubble surface (noise + gradient),
     matching the post card-cta arrow button. Same two-rule split as before. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-btn[aria-pressed='true'] {
      background-color: transparent;
      background-image: var(--bubble-bg-image);
      background-size: var(--bubble-bg-size);
      background-repeat: var(--bubble-bg-repeat);
      box-shadow: var(--bubble-shadow);
    }
  }

  :root[data-theme='dark'] .theme-btn[aria-pressed='true'] {
    background-color: transparent;
    background-image: var(--bubble-bg-image);
    background-size: var(--bubble-bg-size);
    background-repeat: var(--bubble-bg-repeat);
    box-shadow: var(--bubble-shadow);
  }
</style>
