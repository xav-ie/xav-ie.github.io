---
import ExternalLinkIcon from './external-link-icon.astro';

type Contribution = {
  repo: string;
  url: string;
  summary: string;
};

const contributions: Contribution[] = [
  {
    repo: 'atuinsh/atuin',
    url: 'https://github.com/atuinsh/atuin/pulls?q=author%3Axav-ie',
    summary: 'Brought Nushell support to `atuin hex` and OSC 7 cwd mirroring',
  },
  {
    repo: 'agentstation/vhs',
    url: 'https://github.com/agentstation/vhs/pulls?q=author%3Axav-ie',
    summary: 'Fixed SVG animation timing',
  },
  {
    repo: 'korotovsky/slack-mcp-server',
    url: 'https://github.com/korotovsky/slack-mcp-server/pull/141',
    summary: 'Integrated the Slack reactions API',
  },
  {
    repo: 'nolanderc/glsl_analyzer',
    url: 'https://github.com/nolanderc/glsl_analyzer/issues?q=author%3Axav-ie',
    summary: 'Created a CLI formatter',
  },
  {
    repo: 'catgoose/nvim-colorizer.lua',
    url: 'https://github.com/catgoose/nvim-colorizer.lua/pull/160',
    summary: 'Added oklch color highlighting',
  },
  {
    repo: 'Alexays/Waybar',
    url: 'https://github.com/Alexays/Waybar/pulls?q=author%3Axav-ie',
    summary: 'Fixed audio visualizer bugs',
  },
  {
    repo: 'lewis6991/gitsigns.nvim',
    url: 'https://github.com/lewis6991/gitsigns.nvim/pull/1400',
    summary: 'Fixed blame text overflow',
  },
  {
    repo: 'fzakaria/nix-auto-follow',
    url: 'https://github.com/fzakaria/nix-auto-follow/issues?q=author%3Axav-ie',
    summary: 'Fixed dependency duplication bugs',
  },
];
---

<section id="oss" class="col-span-12 section" aria-labelledby="oss-heading">
  <h2 id="oss-heading">Open-Source Contributions</h2>
  <ul class="grid grid-cols-12 gap-4 list-none oss-list" role="list">
    {
      contributions.map((c) => (
        <li class="col-span-12 sm:col-span-6 oss-item">
          <a
            class="oss-card shadow round bg-noise-gradient-155"
            href={c.url}
            target="_blank"
            rel="noreferrer"
          >
            <span class="oss-title">
              <span class="oss-repo">{c.repo}</span>
              <ExternalLinkIcon class="oss-ext" />
              <span class="sr-only">(opens in new tab)</span>
            </span>
            <span class="oss-summary">{c.summary}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .oss-list {
    margin-top: 1em;
    row-gap: 1em;
    column-gap: 0.5em;
  }

  .oss-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding: 1em 2.25em;
    border-radius: 4em;
    text-decoration: none;
    color: var(--foreground);
    height: 100%;
    box-sizing: border-box;
  }

  .oss-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .oss-card:hover :global(.oss-ext),
  .oss-card:focus-visible :global(.oss-ext) {
    transform: translate(1px, -1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .oss-card:hover :global(.oss-ext),
    .oss-card:focus-visible :global(.oss-ext) {
      transform: none;
    }
  }

  .oss-card:hover {
    transform: translateY(-2px);
  }

  .oss-repo {
    font-family: var(--font-code);
    color: var(--alt);
    font-weight: 600;
    word-break: break-all;
  }

  .oss-summary {
    font-size: 0.95em;
    opacity: 0.9;
  }
</style>
