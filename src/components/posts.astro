---
import { getCollection } from 'astro:content';
import PostCard, { type PostData } from './post-card.astro';
import { formatDate } from '../format-date';

// PostData.name is rendered as HTML (so it can contain <wbr> break hints),
// so post titles need to be escaped before being passed through.
const escapeHtml = (s: string) =>
  s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

const all = await getCollection('posts');
const posts: PostData[] = all
  .filter((p) => !p.data.draft)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    name: escapeHtml(post.data.title),
    date: formatDate(post.data.pubDate),
    desc: post.data.description,
    url: `/posts/${post.id}/`,
  }));
---

<section id="posts" class="col-span-12 section" aria-labelledby="posts-heading">
  <h2 id="posts-heading">Posts</h2>
  <ul class="masonry-grid list-none" role="list">
    {posts.map((p) => <PostCard post={p} />)}
  </ul>
</section>
