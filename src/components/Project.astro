---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type ProjectData = {
  name: string;
  date: string;
  desc: string;
  technologiesUsed: string[];
  url: string;
  image?: ImageMetadata;
};

type Props = { project: ProjectData; eager?: boolean };
const { project, eager = false } = Astro.props as Props;

const isExternal = /^https?:\/\//.test(project.url);
const linkAttrs: { target?: string; rel?: string } = isExternal
  ? { target: '_blank', rel: 'noreferrer' }
  : {};
const slug = project.name.toLowerCase().replace(/\s+/g, '-');
const imageLinkLabel = isExternal
  ? `Open ${project.name} on GitHub (new tab)`
  : `Open ${project.name}`;

// SVGs render natively — rasterizing them to AVIF/WebP defeats the point
// and produces blurry tiles at small sizes. Picture handles raster only.
const isSvg = project.image?.format === 'svg';
---

<li class="project col-xs-12 col-md-6">
  <div class="shadow card round">
    <div class="cardImage">
      <a href={project.url} {...linkAttrs} aria-label={imageLinkLabel}>
        {project.image ? (
          <div class="shadow round image-frame">
            {isSvg ? (
              <Image
                src={project.image}
                alt=""
                widths={[300, 600]}
                sizes="(min-width: 48em) 300px, 100vw"
                loading={eager ? 'eager' : 'lazy'}
                decoding={eager ? 'sync' : 'async'}
              />
            ) : (
              <Picture
                src={project.image}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[300, 600]}
                sizes="(min-width: 48em) 300px, 100vw"
                loading={eager ? 'eager' : 'lazy'}
                decoding={eager ? 'sync' : 'async'}
              />
            )}
          </div>
        ) : (
          <div class="shadow round projectPlaceholder" aria-hidden="true">
            <span class="projectPlaceholderText">{slug}</span>
          </div>
        )}
      </a>
    </div>
    <div class="cardContent">
      <h3>{project.name}</h3>
      <p class="date">{project.date}</p>
      <p>{project.desc}</p>
      <p class="technologies">
        {project.technologiesUsed.map((t, i) => (
          <span>{(i ? ', ' : '') + t}</span>
        ))}
      </p>
      <a href={project.url} {...linkAttrs}>{project.url}</a>
    </div>
  </div>
</li>
