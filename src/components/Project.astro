---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type ProjectData = {
  name: string;
  date: string;
  desc: string;
  technologiesUsed: string[];
  url: string;
  image?: ImageMetadata;
};

type Props = { project: ProjectData; eager?: boolean };
const { project, eager = false } = Astro.props as Props;

const isExternal = /^https?:\/\//.test(project.url);
const linkAttrs: { target?: string; rel?: string } = isExternal
  ? { target: '_blank', rel: 'noreferrer' }
  : {};
const slug = project.name.toLowerCase().replace(/\s+/g, '-');
const imageLinkLabel = isExternal
  ? `Open ${project.name} on GitHub (new tab)`
  : `Open ${project.name}`;

const isSvg = project.image?.format === 'svg';
---

<li class="project col-span-12 md:col-span-6">
  <div class="shadow card round">
    <div class="cardImage">
      <a href={project.url} {...linkAttrs} aria-label={imageLinkLabel}>
        {project.image ? (
          <div class="shadow round image-frame">
            {isSvg ? (
              <Image
                src={project.image}
                alt=""
                widths={[300, 600]}
                sizes="(min-width: 48em) 300px, 100vw"
                loading={eager ? 'eager' : 'lazy'}
                decoding={eager ? 'sync' : 'async'}
              />
            ) : (
              <Picture
                src={project.image}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[300, 600]}
                sizes="(min-width: 48em) 300px, 100vw"
                loading={eager ? 'eager' : 'lazy'}
                decoding={eager ? 'sync' : 'async'}
              />
            )}
          </div>
        ) : (
          <div class="shadow shadow-lift round projectPlaceholder" aria-hidden="true">
            <span class="projectPlaceholderText">{slug}</span>
          </div>
        )}
      </a>
    </div>
    <div class="cardContent">
      <h3>{project.name}</h3>
      <p class="date">{project.date}</p>
      <p>{project.desc}</p>
      <p class="technologies">
        {project.technologiesUsed.map((t, i) => (
          <span>{(i ? ', ' : '') + t}</span>
        ))}
      </p>
      <a href={project.url} {...linkAttrs}>{project.url}</a>
    </div>
  </div>
</li>

<style>
  .card {
    padding: 1em;
    background-image:
      var(--noise-image),
      linear-gradient(155deg, var(--surface-top) 0%, var(--surface-bottom) 100%);
    background-size: var(--noise-size), auto;
    background-repeat: repeat, no-repeat;
  }

  .cardContent {
    padding: 0 1em;
  }

  .project h3 {
    font-family: var(--font-code);
  }

  .card::after {
    content: "";
    display: block;
    clear: both;
  }

  .cardImage {
    margin-bottom: 1em;
    max-width: 300px;
  }

  .cardImage .image-frame,
  .cardImage .projectPlaceholder {
    aspect-ratio: 2 / 1;
    width: 100%;
  }

  .cardImage .image-frame > :global(picture) {
    width: 100%;
    height: 100%;
  }

  .cardImage .image-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cardImage a {
    padding: 0 !important;
    margin: 0 !important;
    width: 100%;
    display: block;
  }

  @media (min-width: 48em) {
    .cardImage {
      float: right;
      width: 50%;
      margin-left: 1em;
      margin-bottom: 0.5em;
      position: relative;
      z-index: 1;
    }
  }

  .project a {
    padding: 0.75em;
    margin-left: -0.75em;
    display: inline-block;
    word-break: break-word;
    border-radius: 2em;
  }

  .project .date {
    font-size: 0.9em;
    opacity: 0.75;
    margin: 0 0 0.5em;
  }

  .technologies {
    font-style: italic;
    opacity: 0.85;
  }

  .projectPlaceholder {
    width: 100%;
    aspect-ratio: 2 / 1;
    background:
      radial-gradient(
        circle at 30% 20%,
        rgba(255, 255, 255, 0.05),
        transparent 60%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(81, 209, 54, 0.15),
        transparent 55%
      ),
      linear-gradient(155deg, var(--surface-top) 0%, var(--surface-bottom) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1em;
    box-sizing: border-box;
  }

  .projectPlaceholderText {
    font-family: var(--font-code);
    color: var(--foreground);
    font-size: 1.1em;
    font-weight: 600;
    text-shadow: 0 2px 6px var(--shadow);
    word-break: break-word;
  }
</style>
