---
type Crumb = { url: string; name: string };
type Props = { crumbs: Crumb[] };
const { crumbs } = Astro.props as Props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((crumb, i) => (
        <li>
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={new URL(crumb.url).pathname}>{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 0.5em;
    font-size: 0.9em;
    opacity: 0.8;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.5em;
    opacity: 0.5;
  }
  .breadcrumb [aria-current='page'] {
    opacity: 0.7;
  }
</style>
