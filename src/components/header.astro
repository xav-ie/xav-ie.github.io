---
import GodRays from './god-rays.astro';
import HeartGoldSvg from './heart-gold-svg.astro';
import ThemeToggle from './theme-toggle.astro';

type Props = {
  /**
   * Heading level for the brand name. Use 1 only on the home page (the
   * brand is the page's primary heading); use 2 elsewhere so the page's
   * own content h1 stays the primary heading and the astro-seo-graph
   * H1 validator doesn't see duplicates.
   */
  brandLevel?: 1 | 2;
};

const { brandLevel = 2 } = Astro.props as Props;
---

<div class="header-bleed">
  <GodRays />
  <header>
    <a class="brand col-span-12 headerInner" href="/" aria-label="xav.ie home">
      <div class="logo">
        <HeartGoldSvg size="7em" title="Heart" />
      </div>
      <div class="title">
        {brandLevel === 1
          ? <h1>Xavier Ruiz</h1>
          : <h2>Xavier Ruiz</h2>}
        <p class="brand-tagline">Software Developer</p>
      </div>
    </a>
  </header>
</div>
<nav class="shadow bg-noise-gradient-180" aria-label="Primary">
  <div class="nav-inner">
    <ul class="header-links" role="list">
      <li><a href="/#posts">#posts</a></li>
      <li><a href="/#about_me">#about_me</a></li>
      <li><a href="/#projects">#projects</a></li>
      <li><a href="/#oss">#oss</a></li>
      <li><a href="/#doodles">#doodles</a></li>
    </ul>
    <ThemeToggle />
  </div>
</nav>

<style>
  .header-links li {
    display: inline;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .header-bleed {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  header {
    padding: 1em;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .headerInner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 1em;
    column-gap: 2em;
  }

  header .title {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Brand name renders as <h1> on home and <h2> elsewhere so the page's
     own content h1 stays primary — but the visual treatment is identical
     across pages, so both heading levels get the home-page h1 size. */
  header .title h1,
  header .title h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 3em;
  }

  header .brand-tagline {
    margin: 0;
    font-size: 2em;
  }

  .brand {
    color: inherit;
    text-decoration: none;
  }

  nav {
    background-color: var(--surface-bottom);
    position: sticky;
    top: 0;
    min-height: 3.25em;
    z-index: 10;
    border-bottom: 1px solid var(--shadow);
    padding: 0 1em;
    display: flex;
    align-items: center;
  }

  /* Constrain nav contents to the same 1200px content column as
     <main> and <header>, so the links anchor to the same left edge
     and the theme toggle anchors to the same right edge. */
  .nav-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    box-sizing: border-box;
  }

  nav ul.header-links {
    background: transparent;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    padding: 0.65em 0.5em;
    display: inline-block;
  }

  @media (max-width: 500px) {
    .headerInner {
      justify-content: center;
    }
    .headerInner .title {
      text-align: center;
    }
  }
</style>
