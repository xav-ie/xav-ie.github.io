---
import { Picture } from 'astro:assets';
import me, { PROFILE_IMAGE_OPTS } from '../assets/profile';
---

<section
  id="about_me"
  class="col-span-12 section"
  aria-labelledby="about-me-heading"
>
  <h2 id="about-me-heading">About Me</h2>
  <div class="grid grid-cols-12 gap-4">
    <div class="col-span-12 sm:col-span-4 lg:col-span-3">
      <div class="profileImage shadow round image-frame">
        <Picture
          src={me}
          alt="Xavier Ruiz"
          {...PROFILE_IMAGE_OPTS}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="col-span-12 sm:col-span-8 lg:col-span-6 bio">
      <p>
        Hi, I'm Xavier and I live in Boston. I currently work in the e-commerce
        space, building tools to make stores fast, accessible, and well-tested.
        In my free time, I like to play board games, try new foods, and fiddle
        with my dotfiles.
      </p>
      <p>
        I also help run <a href="https://bostonts.club">bostonts.club</a>, a
        monthly meetup for all things TypeScript and web development.
      </p>
      <p>
        You can reach me at <a href="mailto:hello@xav.ie">hello@xav.ie</a>, or
        find me on{' '}
        <a rel="me" href="https://github.com/xav-ie">GitHub</a> and{' '}
        <a rel="me" href="https://www.linkedin.com/in/xav-ie/">LinkedIn</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .profileImage {
    width: 100%;
    max-width: 300px;
  }

  .profileImage > :global(picture) {
    display: block;
    line-height: 0;
  }

  .profileImage :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .bio {
    text-align: left;
  }
</style>
