---
import { getCollection } from 'astro:content';
import { breadcrumbsFromUrl } from '@jdevalk/astro-seo-graph';
import {
  buildBreadcrumbList,
  buildWebPage,
  type GraphEntity,
} from '@jdevalk/seo-graph-core';
import Base from '../../layouts/base.astro';
import Breadcrumb from '../../components/breadcrumb.astro';
import PostCard, { type PostData } from '../../components/post-card.astro';
import { SITE_URL, ids } from '../../lib/schema';
import { formatDate } from '../../format-date';

const escapeHtml = (s: string) =>
  s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

const all = await getCollection('posts');
const posts: PostData[] = all
  .filter((p) => !p.data.draft)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    name: escapeHtml(post.data.title),
    date: formatDate(post.data.pubDate),
    desc: post.data.description,
    url: `/posts/${post.id}/`,
  }));

const pageUrl = Astro.url.href;
const pageName = 'Posts';
const pageDescription = 'Writing from Xavier Ruiz.';
const crumbs = breadcrumbsFromUrl({
  url: Astro.url,
  siteUrl: SITE_URL,
  pageName,
});

const graphPieces: GraphEntity[] = [
  buildWebPage(
    {
      url: pageUrl,
      name: pageName,
      description: pageDescription,
      isPartOf: { '@id': ids.website },
      breadcrumb: { '@id': ids.breadcrumb(pageUrl) },
      inLanguage: 'en-US',
    },
    ids,
    'CollectionPage',
  ) as GraphEntity,
  buildBreadcrumbList({ url: pageUrl, items: crumbs }, ids) as GraphEntity,
];
---

<Base
  title="Posts — xav.ie"
  description={pageDescription}
  graphPieces={graphPieces}
>
  <main id="main-content">
    <Breadcrumb crumbs={crumbs} />
    <h1>Posts</h1>
    <p>
      Also available as <a href="/rss.xml">RSS</a>.
    </p>
    <ul class="masonry-grid list-none" role="list">
      {posts.map((p) => <PostCard post={p} />)}
    </ul>
  </main>
</Base>

<style>
  main {
    margin: 2em auto;
  }
</style>
