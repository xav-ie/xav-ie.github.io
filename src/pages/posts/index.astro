---
import { getCollection } from 'astro:content';
import { breadcrumbsFromUrl } from '@jdevalk/astro-seo-graph';
import {
  buildBreadcrumbList,
  buildWebPage,
  type GraphEntity,
} from '@jdevalk/seo-graph-core';
import Base from '../../layouts/base.astro';
import Breadcrumb from '../../components/breadcrumb.astro';
import { SITE_URL, ids } from '../../lib/schema';
import { formatDate } from '../../format-date';

const all = await getCollection('posts');
const posts = all
  .filter((p) => !p.data.draft)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageUrl = Astro.url.href;
const pageName = 'Posts';
const pageDescription = 'Writing from Xavier Ruiz.';
const crumbs = breadcrumbsFromUrl({
  url: Astro.url,
  siteUrl: SITE_URL,
  pageName,
});

const graphPieces: GraphEntity[] = [
  buildWebPage(
    {
      url: pageUrl,
      name: pageName,
      description: pageDescription,
      isPartOf: { '@id': ids.website },
      breadcrumb: { '@id': ids.breadcrumb(pageUrl) },
      inLanguage: 'en-US',
    },
    ids,
    'CollectionPage',
  ) as GraphEntity,
  buildBreadcrumbList({ url: pageUrl, items: crumbs }, ids) as GraphEntity,
];
---

<Base title="Posts — xav.ie" description={pageDescription} graphPieces={graphPieces}>
  <main id="main-content">
    <Breadcrumb crumbs={crumbs} />
    <h1>Posts</h1>
    <p>
      Also available as <a href="/rss.xml">RSS</a>.
    </p>
    <ul class="list-none" role="list">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  main { max-width: 39em; margin: 2em auto; }
  ul { display: grid; gap: 1.5em; }
  li time { opacity: 0.7; font-size: 0.9em; margin-left: 0.5em; }
  li p { margin: 0.25em 0 0; opacity: 0.85; }
</style>
