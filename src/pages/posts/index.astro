---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = await getCollection('posts');
const posts = all
  .filter((p) => !p.data.draft)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Posts — xav.ie" description="Writing from Xavier Ruiz.">
  <main>
    <h1>Posts</h1>
    <p>
      Also available as <a href="/rss.xml">RSS</a>.
    </p>
    <ul class="list-none">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  main { max-width: 65ch; margin: 2em auto; }
  ul { display: grid; gap: 1.5em; }
  li time { opacity: 0.7; font-size: 0.9em; margin-left: 0.5em; }
  li p { margin: 0.25em 0 0; opacity: 0.85; }
</style>
