---
import { getCollection, render } from 'astro:content';
import { breadcrumbsFromUrl } from '@jdevalk/astro-seo-graph';
import Base from '../../layouts/base.astro';
import Breadcrumb from '../../components/breadcrumb.astro';
import { SITE_URL, postPieces } from '../../lib/schema';
import { formatDate } from '../../format-date';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;

const crumbs = breadcrumbsFromUrl({
  url: Astro.url,
  siteUrl: SITE_URL,
  pageName: title,
  names: { posts: 'Posts' },
});

const graphPieces = postPieces(post);
---

<Base
  title={`${title} — xav.ie`}
  description={description}
  ogType="article"
  article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
  graphPieces={graphPieces}
>
  <main id="main-content">
    <Breadcrumb crumbs={crumbs} />
    <article>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            {' · updated '}
            <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </>
        )}
      </p>
      <Content />
    </article>
  </main>
</Base>

<style>
  main {
    max-width: 39em;
    margin: 2em auto;
  }
  article {
    margin: 0;
  }
  .meta {
    opacity: 0.7;
    font-size: 0.9em;
    margin: 0 0 2em;
  }
</style>
