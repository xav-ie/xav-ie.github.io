---
// Dev-only tuning page for the body font (IBM Plex Sans). Open
// http://localhost:4321/font-tuner. Overlay the fallback and loaded font,
// slide @font-face descriptors until the two visually align, then paste
// the generated @font-face into src/styles/global.css.

type Preset = {
  name: string;
  sizeAdjust: number;
  ascent: number;
  descent: number;
  lineGap: number;
  srcUrl?: string;
};

type Sample = {
  label: string;
  text: string;
  size: string;
  weight?: number;
};

type Target = {
  label: string;
  webFont: string;
  googleHref: string;
  fallbackPrefix: string;
  presets: Preset[];
  samples: Sample[];
};

const targets: Record<string, Target> = {
  body: {
    label: 'Body (IBM Plex Sans)',
    webFont: 'IBM Plex Sans',
    googleHref:
      'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300..700&display=swap',
    fallbackPrefix: 'IBM Plex Sans Fallback',
    // Starting points are educated guesses based on each font's typical
    // metrics; tune from here.
    presets: [
      { name: 'Helvetica',       sizeAdjust: 100, ascent: 95,  descent: 23, lineGap: 0 },
      { name: 'Helvetica Neue',  sizeAdjust: 100, ascent: 95,  descent: 23, lineGap: 0 },
      { name: 'Arial',           sizeAdjust: 105, ascent: 90,  descent: 22, lineGap: 0 },
      { name: 'Segoe UI',        sizeAdjust: 95,  ascent: 100, descent: 25, lineGap: 0 },
      {
        name: 'Roboto',
        sizeAdjust: 95,
        ascent: 95,
        descent: 25,
        lineGap: 0,
        srcUrl:
          'https://cdn.jsdelivr.net/fontsource/fonts/roboto@latest/latin-400-normal.woff2',
      },
      {
        name: 'Noto Sans',
        sizeAdjust: 100,
        ascent: 100,
        descent: 25,
        lineGap: 0,
        srcUrl:
          'https://cdn.jsdelivr.net/fontsource/fonts/noto-sans@latest/latin-400-normal.woff2',
      },
    ],
    samples: [
      {
        label: 'Paragraph (intro)',
        size: '1em',
        text: "Hi, I'm Xavier and I live in Boston. I currently work in the e-commerce space, building tools to make stores fast, accessible, and well-tested.",
      },
      {
        label: 'Project description',
        size: '1em',
        text: 'An email client that runs inside Neovim. Threaded message lists, structured per-field search, in-buffer composing with auto-saved drafts.',
      },
      {
        label: 'Date / caption',
        size: '0.9em',
        text: 'February 2026 – Present',
      },
      {
        label: 'Bold title',
        size: '1.1em',
        weight: 600,
        text: 'himalaya-nvim',
      },
    ],
  },
};

const requested = Astro.url.searchParams.get('target') ?? 'body';
const targetId = (requested in targets ? requested : 'body') as keyof typeof targets;
const target = targets[targetId];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{target.label} — Font Tuner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={target.googleHref} />
    <style>
      :root {
        --bg: #12081a;
        --fg: #fff17b;
        --alt: #51d136;
        --fallback-color: #ff5c8a;
        --loaded-color: #6cd9ff;
        --panel: rgba(255, 255, 255, 0.06);
        --rule: rgba(255, 255, 255, 0.08);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 2rem;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.5;
      }
      h1 { margin: 0 0 0.25em; }
      .lede { opacity: 0.8; max-width: 60ch; margin: 0 0 1.5em; }

      .legend {
        display: flex;
        gap: 1em;
        margin-bottom: 1em;
        font-size: 0.9em;
      }
      .swatch {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
      }
      .swatch::before {
        content: "";
        display: inline-block;
        width: 12px; height: 12px;
        background: currentColor;
        border-radius: 2px;
      }
      .swatch-fallback { color: var(--fallback-color); }
      .swatch-loaded { color: var(--loaded-color); }

      .layout {
        display: grid;
        gap: 2rem;
        grid-template-columns: 320px 1fr;
        align-items: start;
      }
      @media (max-width: 800px) {
        .layout { grid-template-columns: 1fr; }
      }

      .controls {
        position: sticky;
        top: 1rem;
        background: var(--panel);
        padding: 1.25rem;
        border-radius: 12px;
        border: 1px solid var(--rule);
        display: grid;
        gap: 1rem;
      }
      .control { display: grid; gap: 0.35em; }
      .control label { font-size: 0.85em; opacity: 0.85; }
      .control select, .control input[type="range"] { width: 100%; }
      .control .value {
        font-family: ui-monospace, SFMono-Regular, monospace;
        color: var(--alt);
      }
      .radios { display: grid; gap: 0.3em; }
      .radio {
        display: flex;
        align-items: center;
        gap: 0.5em;
        padding: 0.35em 0.5em;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid transparent;
      }
      .radio:hover { background: rgba(255, 255, 255, 0.04); }
      .radio:has(input:checked) {
        background: rgba(81, 209, 54, 0.12);
        border-color: var(--alt);
      }
      .radio input { accent-color: var(--alt); }
      .mode {
        display: flex;
        gap: 0.5em;
        flex-wrap: wrap;
      }
      .mode button {
        flex: 1;
        background: transparent;
        border: 1px solid var(--rule);
        color: var(--fg);
        padding: 0.4em 0.6em;
        border-radius: 6px;
        cursor: pointer;
        font: inherit;
      }
      .mode button[aria-pressed="true"] {
        background: var(--alt);
        color: var(--bg);
        border-color: var(--alt);
      }

      .preview { display: grid; gap: 1.5em; }
      .sample {
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 1em 1.25em;
        background: rgba(0, 0, 0, 0.25);
      }
      .sample-label {
        font-size: 0.8em;
        opacity: 0.6;
        margin-bottom: 0.5em;
        font-family: ui-monospace, SFMono-Regular, monospace;
      }
      .stack { position: relative; }
      .layer {
        margin: 0;
        line-height: 1.4;
      }
      .layer-fallback {
        font-family: 'Tuned Fallback', var(--web-fallback);
        color: var(--fallback-color);
      }
      .layer-loaded {
        position: absolute;
        inset: 0;
        font-family: var(--web-font);
        color: var(--loaded-color);
        pointer-events: none;
      }
      body[data-mode="fallback"] .layer-loaded { display: none; }
      body[data-mode="loaded"] .layer-fallback { visibility: hidden; }
      body[data-mode="loaded"] .layer-loaded { position: static; }

      .output {
        margin-top: 2em;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 1em 1.25em;
      }
      .output pre {
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.85em;
        margin: 0.5em 0 0;
        overflow-x: auto;
        color: var(--alt);
        white-space: pre-wrap;
      }
      .copy {
        background: var(--alt);
        color: var(--bg);
        border: none;
        padding: 0.5em 0.9em;
        border-radius: 6px;
        cursor: pointer;
        font: inherit;
        font-weight: 600;
      }
      .copy:active { transform: translateY(1px); }
    </style>
    <style id="tuned-face" is:inline></style>
  </head>
  <body
    data-mode="overlay"
    data-target={targetId}
    data-web-font={target.webFont}
    data-fallback-prefix={target.fallbackPrefix}
    style={`--web-font: "${target.webFont}", sans-serif; --web-fallback: sans-serif;`}
  >
    <h1>Font Tuner — {target.label}</h1>
    <p class="lede">
      Tune <code>@font-face</code> descriptors on a local fallback so it matches
      <strong>{target.webFont}</strong>'s metrics. Pink = your tuned fallback;
      blue = the loaded web font. When pink hides behind blue, the swap will
      be invisible.
    </p>

    <div class="legend">
      <span class="swatch swatch-fallback">tuned fallback</span>
      <span class="swatch swatch-loaded">{target.webFont}</span>
    </div>

    <div class="layout">
      <aside class="controls">
        <div class="control">
          <label>Fallback font</label>
          <div class="radios" role="radiogroup" aria-label="Fallback font">
            {target.presets.map((f, i) => (
              <label class="radio">
                <input
                  type="radio"
                  name="fallback"
                  value={f.name}
                  data-size-adjust={f.sizeAdjust}
                  data-ascent={f.ascent}
                  data-descent={f.descent}
                  data-line-gap={f.lineGap}
                  data-src-url={f.srcUrl ?? ''}
                  checked={i === 0}
                />
                <span>{f.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="control">
          <label for="size-adjust">
            size-adjust <span class="value" id="v-size-adjust">100%</span>
          </label>
          <input id="size-adjust" type="range" min="50" max="200" step="0.5" value="100" />
        </div>

        <div class="control">
          <label for="ascent-override">
            ascent-override <span class="value" id="v-ascent-override">90%</span>
          </label>
          <input id="ascent-override" type="range" min="50" max="150" step="0.5" value="90" />
        </div>

        <div class="control">
          <label for="descent-override">
            descent-override <span class="value" id="v-descent-override">22%</span>
          </label>
          <input id="descent-override" type="range" min="0" max="60" step="0.5" value="22" />
        </div>

        <div class="control">
          <label for="line-gap-override">
            line-gap-override <span class="value" id="v-line-gap-override">0%</span>
          </label>
          <input id="line-gap-override" type="range" min="0" max="60" step="0.5" value="0" />
        </div>

        <div class="control">
          <label>View</label>
          <div class="mode" role="group" aria-label="View mode">
            <button data-mode="overlay" aria-pressed="true">Overlay</button>
            <button data-mode="fallback" aria-pressed="false">Fallback only</button>
            <button data-mode="loaded" aria-pressed="false">Loaded only</button>
          </div>
        </div>
      </aside>

      <section class="preview">
        {target.samples.map((s) => (
          <div class="sample">
            <div class="sample-label">{s.label}</div>
            <div
              class="stack"
              style={`font-size:${s.size};${s.weight ? `font-weight:${s.weight};` : ''}`}
            >
              <div class="layer layer-fallback">{s.text}</div>
              <div class="layer layer-loaded">{s.text}</div>
            </div>
          </div>
        ))}

        <div class="output">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:1em">
            <strong>Generated CSS</strong>
            <button class="copy" id="copy">Copy</button>
          </div>
          <pre id="generated"></pre>
        </div>
      </section>
    </div>

    <script>
      const $ = <T extends Element = Element>(sel: string) =>
        document.querySelector(sel) as T;

      const body = document.body;
      const webFont = body.dataset.webFont ?? '';
      const fallbackPrefix = body.dataset.fallbackPrefix ?? 'Fallback';

      const tunedFace = $('#tuned-face') as HTMLStyleElement;
      const generated = $('#generated') as HTMLPreElement;

      const fields = {
        sizeAdjust: $('#size-adjust') as HTMLInputElement,
        ascent: $('#ascent-override') as HTMLInputElement,
        descent: $('#descent-override') as HTMLInputElement,
        lineGap: $('#line-gap-override') as HTMLInputElement,
      };
      const valueLabels = {
        sizeAdjust: $('#v-size-adjust') as HTMLSpanElement,
        ascent: $('#v-ascent-override') as HTMLSpanElement,
        descent: $('#v-descent-override') as HTMLSpanElement,
        lineGap: $('#v-line-gap-override') as HTMLSpanElement,
      };

      const radios = document.querySelectorAll<HTMLInputElement>(
        'input[name="fallback"]',
      );
      const getSelectedRadio = () =>
        Array.from(radios).find((r) => r.checked) ?? radios[0];
      const getFallback = () => getSelectedRadio().value;
      const getSrcUrl = () => getSelectedRadio().dataset.srcUrl ?? '';

      function render() {
        const fallback = getFallback();
        const srcUrl = getSrcUrl();
        const sizeAdjust = fields.sizeAdjust.value;
        const ascent = fields.ascent.value;
        const descent = fields.descent.value;
        const lineGap = fields.lineGap.value;

        valueLabels.sizeAdjust.textContent = `${sizeAdjust}%`;
        valueLabels.ascent.textContent = `${ascent}%`;
        valueLabels.descent.textContent = `${descent}%`;
        valueLabels.lineGap.textContent = `${lineGap}%`;

        const src = srcUrl
          ? `local('${fallback}'), url('${srcUrl}') format('woff2')`
          : `local('${fallback}')`;

        // Two faces: 'Tuned Fallback' is what the page previews; the
        // second is the family name to drop into global.css verbatim,
        // suffixed with the fallback font name so multiple presets can
        // coexist in the production stack.
        const productionFamily = `${fallbackPrefix} ${fallback}`;
        const previewCss = `@font-face {
  font-family: 'Tuned Fallback';
  src: ${src};
  size-adjust: ${sizeAdjust}%;
  ascent-override: ${ascent}%;
  descent-override: ${descent}%;
  line-gap-override: ${lineGap}%;
}`;
        const productionCss = `@font-face {
  font-family: "${productionFamily}";
  src: local("${fallback}");
  size-adjust: ${sizeAdjust}%;
  ascent-override: ${ascent}%;
  descent-override: ${descent}%;
  line-gap-override: ${lineGap}%;
}`;

        tunedFace.textContent = previewCss;
        generated.textContent = productionCss;

        try {
          const url = new URL(window.location.href);
          url.searchParams.set('f', fallback);
          url.searchParams.set('sa', sizeAdjust);
          url.searchParams.set('a', ascent);
          url.searchParams.set('d', descent);
          url.searchParams.set('lg', lineGap);
          history.replaceState(null, '', url.toString());
        } catch {}
      }

      // Restore from URL so settings can be shared / refreshed (scoped by
      // the current ?target since that's part of the URL).
      const params = new URLSearchParams(window.location.search);
      const urlFallback = params.get('f');
      if (urlFallback) {
        const match = Array.from(radios).find((r) => r.value === urlFallback);
        if (match) match.checked = true;
      }
      const initial = getSelectedRadio();
      // Default sliders to the selected preset's values.
      fields.sizeAdjust.value = initial.dataset.sizeAdjust ?? '100';
      fields.ascent.value = initial.dataset.ascent ?? '90';
      fields.descent.value = initial.dataset.descent ?? '22';
      fields.lineGap.value = initial.dataset.lineGap ?? '0';
      // URL overrides preset.
      if (params.get('sa')) fields.sizeAdjust.value = params.get('sa')!;
      if (params.get('a')) fields.ascent.value = params.get('a')!;
      if (params.get('d')) fields.descent.value = params.get('d')!;
      if (params.get('lg')) fields.lineGap.value = params.get('lg')!;

      for (const el of Object.values(fields)) {
        el.addEventListener('input', render);
      }

      for (const r of radios) {
        r.addEventListener('change', () => {
          if (!r.checked) return;
          fields.sizeAdjust.value = r.dataset.sizeAdjust ?? '100';
          fields.ascent.value = r.dataset.ascent ?? '90';
          fields.descent.value = r.dataset.descent ?? '22';
          fields.lineGap.value = r.dataset.lineGap ?? '0';
          render();
        });
      }

      document.querySelectorAll<HTMLButtonElement>('.mode button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode!;
          document.body.dataset.mode = mode;
          document.querySelectorAll<HTMLButtonElement>('.mode button').forEach((b) => {
            b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
          });
        });
      });

      ($('#copy') as HTMLButtonElement).addEventListener('click', async () => {
        const btn = $('#copy') as HTMLButtonElement;
        await navigator.clipboard.writeText(generated.textContent ?? '');
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1200);
      });

      // Suppress an unused-variable warning for webFont; it's used via the
      // CSS custom property --web-font set on body[style].
      void webFont;

      render();
    </script>
  </body>
</html>
