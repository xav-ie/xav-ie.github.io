---
import Base from '../layouts/base.astro';
---

<Base title="Not found · xav.ie" description="That page doesn't exist on xav.ie." noindex>
  <main id="main-content" class="notfound">
    <h1>404</h1>
    <p>That page doesn't exist.</p>
    <p><a href="/">Back to xav.ie</a></p>
  </main>
</Base>

<style>
  main.notfound {
    text-align: center;
    padding: 4em 1em;
  }
  main.notfound h1 {
    font-family: var(--font-heading);
    font-size: 6em;
    margin: 0;
  }
</style>
