---
import { getImage } from 'astro:assets';
import { buildWebPage, type GraphEntity } from '@jdevalk/seo-graph-core';
import Base from '../layouts/base.astro';
import AboutMe from '../components/about-me.astro';
import Posts from '../components/posts.astro';
import Projects from '../components/projects.astro';
import OpenSource from '../components/open-source.astro';
import Doodles from '../components/doodles.astro';
import Footer from '../components/footer.astro';
import me, { PROFILE_IMAGE_OPTS } from '../assets/profile';
import { SITE_URL, ids } from '../lib/schema';

const meOptimized = await getImage({
  src: me,
  format: 'avif',
  ...PROFILE_IMAGE_OPTS,
});

const pageUrl = `${SITE_URL}/`;
const graphPieces: GraphEntity[] = [
  buildWebPage(
    {
      url: pageUrl,
      name: 'Xavier Ruiz — Software Developer',
      description:
        'Personal site of Xavier Ruiz — a full-stack developer in Boston.',
      isPartOf: { '@id': ids.website },
      inLanguage: 'en-US',
      mainEntity: { '@id': ids.person },
      about: { '@id': ids.person },
    },
    ids,
    'ProfilePage',
  ) as GraphEntity,
];
---

<Base title="Xavier Ruiz" graphPieces={graphPieces}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    href={meOptimized.src}
    imagesrcset={meOptimized.srcSet.attribute}
    imagesizes={meOptimized.attributes.sizes}
    fetchpriority="high"
  />
  <div class="App">
    <main id="main-content">
      <Posts />
      <AboutMe />
      <Projects />
      <OpenSource />
      <Doodles />
    </main>
    <Footer />
  </div>
</Base>
