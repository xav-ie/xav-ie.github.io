---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import AboutMe from '../components/AboutMe.astro';
import Projects from '../components/Projects.astro';
import OpenSource from '../components/OpenSource.astro';
import Doodles from '../components/Doodles.astro';
import Footer from '../components/Footer.astro';
import me from '../assets/me.jpg';

// Pre-resolve the LCP avatar as AVIF so the preload <link> matches the
// first <source> in the <Picture> in AboutMe.astro. Browsers that don't
// support AVIF skip this preload (per the type hint) and fetch the WebP
// fallback from <picture>. Astro deduplicates the image transform, so
// this does not generate an extra build artifact.
const meOptimized = await getImage({
  src: me,
  format: 'avif',
  widths: [300, 600],
  sizes: '300px',
});
---

<Base>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    href={meOptimized.src}
    imagesrcset={meOptimized.srcSet.attribute}
    imagesizes={meOptimized.attributes.sizes}
    fetchpriority="high"
  />
  <div class="App">
    <Header />
    <main>
      <AboutMe />
      <Projects />
      <OpenSource />
      <Doodles />
    </main>
    <Footer />
  </div>
</Base>
