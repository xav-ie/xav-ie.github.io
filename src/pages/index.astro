---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import AboutMe from '../components/AboutMe.astro';
import Projects from '../components/Projects.astro';
import OpenSource from '../components/OpenSource.astro';
import Doodles from '../components/Doodles.astro';
import Footer from '../components/Footer.astro';
import me from '../assets/me.jpg';

// Pre-resolve the LCP avatar so the preload <link> points at the same
// hashed asset URLs that <Image> will request from AboutMe.astro.
// Astro deduplicates the underlying image transforms, so this doesn't
// generate extra output.
const meOptimized = await getImage({
  src: me,
  widths: [300, 600],
  sizes: '(min-width: 75em) 300px, (min-width: 48em) 33vw, 100vw',
});
---

<Base>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={meOptimized.src}
    imagesrcset={meOptimized.srcSet.attribute}
    imagesizes={meOptimized.attributes.sizes}
    fetchpriority="high"
  />
  <div class="App">
    <Header />
    <main>
      <AboutMe />
      <Projects />
      <OpenSource />
      <Doodles />
    </main>
    <Footer />
  </div>
</Base>
